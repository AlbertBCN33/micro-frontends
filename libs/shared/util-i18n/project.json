{
	"name": "shared-util-i18n",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/shared/util-i18n/src",
	"prefix": "i18n",
	"projectType": "library",
	"tags": ["type:util", "scope:shared"],
	"targets": {
		"build": {
			"executor": "@nx/angular:package",
			"outputs": ["{workspaceRoot}/dist/{projectRoot}"],
			"defaultConfiguration": "production",
			"options": {
				"project": "libs/shared/util-i18n/ng-package.json",
				"tsConfig": "libs/shared/util-i18n/tsconfig.lib.json"
			},
			"configurations": {
				"production": {
					"tsConfig": "libs/shared/util-i18n/tsconfig.lib.prod.json"
				},
				"development": {}
			}
		},
		"nx-release-publish": {
			"options": {
				"packageRoot": "dist/{projectRoot}"
			}
		},
		"test": {
			"outputs": [
				"{projectRoot}/{options.coverage.reportsDirectory}",
				"{workspaceRoot}/coverage/libs/shared/util-i18n"
			],
			"options": {
				"coverage.reportsDirectory": "../../../coverage/libs/shared/util-i18n"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"typecheck": {
			"command": "tsc -p libs/shared/util-i18n/tsconfig.spec.json --noEmit"
		}
	}
}
