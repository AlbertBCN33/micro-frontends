{
	"name": "shell-e2e",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/shell-e2e/src",
	"tags": ["type:e2e", "scope:shell"],
	"implicitDependencies": ["shell", "market", "wishlist"],
	"// targets": "to see all targets run: nx show project shell-e2e --web",
	"targets": {
		"e2e": {
			"dependsOn": [
				{
					"projects": ["shell", "market", "wishlist"],
					"target": "build"
				}
			]
		},
		"typecheck": {
			"command": "tsc -p apps/shell-e2e/tsconfig.json --noEmit"
		}
	}
}
