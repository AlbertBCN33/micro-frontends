{
	"name": "wishlist",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "wishlist",
	"sourceRoot": "apps/wishlist/src",
	"tags": ["type:app", "scope:wishlist"],
	"targets": {
		"build": {
			"executor": "@angular-architects/native-federation:build",
			"defaultConfiguration": "production",
			"options": {
				"cacheExternalArtifacts": true,
				"tsConfig": "apps/wishlist/tsconfig.federation.json"
			},
			"configurations": {
				"production": {
					"target": "wishlist:esbuild:production"
				},
				"development": {
					"target": "wishlist:esbuild:development",
					"dev": true
				}
			}
		},
		"serve": {
			"executor": "@angular-architects/native-federation:build",
			"options": {
				"target": "wishlist:serve-original:development",
				"tsConfig": "apps/wishlist/tsconfig.federation.json",
				"rebuildDelay": 500,
				"cacheExternalArtifacts": true,
				"dev": true,
				"devServer": true,
				"port": 0
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test": {
			"outputs": [
				"{projectRoot}/{options.coverage.reportsDirectory}",
				"{workspaceRoot}/coverage/apps/wishlist"
			],
			"options": {
				"coverage.reportsDirectory": "../../coverage/apps/wishlist"
			}
		},
		"serve-static": {
			"continuous": true,
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "wishlist:build",
				"port": 4202,
				"staticFilePath": "dist/apps/wishlist/browser",
				"spa": true
			}
		},
		"esbuild": {
			"executor": "@angular/build:application",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/apps/wishlist",
				"browser": "apps/wishlist/src/main.ts",
				"tsConfig": "apps/wishlist/tsconfig.app.json",
				"inlineStyleLanguage": "sass",
				"assets": [
					{
						"glob": "**/*",
						"input": "apps/wishlist/public"
					}
				],
				"styles": [
					"libs/shared/ui/src/styles/theme.css",
					"apps/wishlist/src/styles.sass"
				],
				"polyfills": ["es-module-shims"]
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "1mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "4kb",
							"maximumError": "8kb"
						}
					],
					"outputHashing": "all"
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			}
		},
		"serve-original": {
			"continuous": true,
			"executor": "@angular/build:dev-server",
			"defaultConfiguration": "development",
			"options": {
				"port": 4202
			},
			"configurations": {
				"production": {
					"buildTarget": "wishlist:esbuild:production"
				},
				"development": {
					"buildTarget": "wishlist:esbuild:development"
				}
			}
		},
		"typecheck": {
			"command": "tsc -p apps/wishlist/tsconfig.spec.json --noEmit"
		}
	}
}
