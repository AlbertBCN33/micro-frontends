{
	"name": "shell",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "shell",
	"sourceRoot": "apps/shell/src",
	"tags": ["type:app", "scope:shell"],
	"targets": {
		"build": {
			"executor": "@angular-architects/native-federation:build",
			"defaultConfiguration": "production",
			"options": {
				"cacheExternalArtifacts": true,
				"tsConfig": "apps/shell/tsconfig.federation.json"
			},
			"configurations": {
				"production": {
					"target": "shell:esbuild:production"
				},
				"development": {
					"target": "shell:esbuild:development",
					"dev": true
				}
			},
			"dependsOn": ["generate-env", "^build"],
			"inputs": [
				"production",
				"^production",
				{
					"env": "FIREBASE_API_KEY"
				},
				{
					"env": "FIREBASE_AUTH_DOMAIN"
				},
				{
					"env": "FIREBASE_PROJECT_ID"
				},
				{
					"env": "FIREBASE_STORAGE_BUCKET"
				},
				{
					"env": "FIREBASE_MESSAGING_SENDER_ID"
				},
				{
					"env": "FIREBASE_APP_ID"
				},
				{
					"env": "FIREBASE_MEASUREMENT_ID"
				},
				"{workspaceRoot}/README.md"
			],
			"cache": true,
			"outputs": ["{workspaceRoot}/dist/apps/shell"]
		},
		"serve": {
			"executor": "@angular-architects/native-federation:build",
			"options": {
				"target": "shell:serve-original:development",
				"tsConfig": "apps/shell/tsconfig.federation.json",
				"rebuildDelay": 500,
				"cacheExternalArtifacts": true,
				"dev": true,
				"devServer": true,
				"port": 0
			},
			"dependsOn": ["generate-env"]
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test": {
			"outputs": [
				"{projectRoot}/{options.coverage.reportsDirectory}",
				"{workspaceRoot}/coverage/apps/shell"
			],
			"options": {
				"coverage.reportsDirectory": "../../coverage/apps/shell"
			},
			"dependsOn": ["generate-env"],
			"inputs": ["default", "^production", "{workspaceRoot}/README.md"]
		},
		"serve-static": {
			"continuous": true,
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "shell:build",
				"port": 4200,
				"staticFilePath": "dist/apps/shell/browser",
				"spa": true
			}
		},
		"esbuild": {
			"executor": "@angular/build:application",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/apps/shell",
				"browser": "apps/shell/src/main.ts",
				"tsConfig": "apps/shell/tsconfig.app.json",
				"inlineStyleLanguage": "sass",
				"assets": [
					{
						"glob": "**/*",
						"input": "apps/shell/public"
					}
				],
				"styles": [
					"libs/shared/ui/src/styles/theme.css",
					"apps/shell/src/styles.sass"
				],
				"polyfills": ["es-module-shims"],
				"loader": {
					".md": "text"
				}
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "1mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "4kb",
							"maximumError": "8kb"
						}
					],
					"outputHashing": "all"
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			}
		},
		"serve-original": {
			"continuous": true,
			"executor": "@angular/build:dev-server",
			"defaultConfiguration": "development",
			"options": {
				"port": 4200
			},
			"configurations": {
				"production": {
					"buildTarget": "shell:esbuild:production"
				},
				"development": {
					"buildTarget": "shell:esbuild:development"
				}
			}
		},
		"typecheck": {
			"command": "tsc -p apps/shell/tsconfig.spec.json --noEmit",
			"dependsOn": ["generate-env"],
			"inputs": [
				"default",
				"^production",
				{
					"env": "FIREBASE_API_KEY"
				},
				{
					"env": "FIREBASE_AUTH_DOMAIN"
				},
				{
					"env": "FIREBASE_PROJECT_ID"
				},
				{
					"env": "FIREBASE_STORAGE_BUCKET"
				},
				{
					"env": "FIREBASE_MESSAGING_SENDER_ID"
				},
				{
					"env": "FIREBASE_APP_ID"
				},
				{
					"env": "FIREBASE_MEASUREMENT_ID"
				},
				"{workspaceRoot}/README.md"
			]
		},
		"generate-env": {
			"command": "node tools/scripts/generate-env.mjs",
			"cache": false
		}
	}
}
