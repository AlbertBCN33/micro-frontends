# Copy to `.env` (git-ignored) and fill in. `nx build|serve|test shell` turns it
# into apps/shell/src/environments/firebase-config.generated.ts.
#
# Values come from: Firebase console → Project settings → Your apps → Web app.
# Note: Firebase *web* config is not a secret. It ships inside the JS bundle
# of any deployed site. Keeping it out of git avoids publishing project
# identifiers; access is protected by API-key restrictions (HTTP referrers)
# and Firebase Security Rules, not by hiding these values.
#
# Leave all empty to run without Firebase (the app does not require it).

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
